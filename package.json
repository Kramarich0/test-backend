{
  "name": "test-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "arch:baseline": "depcruise src --config .dependency-cruiser.ts --baseline",
    "arch:check": "depcruise src --config .dependency-cruiser.ts --output-type err --ignore-known",
    "build": "prisma generate && nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "pnpm db:generate && nest start --watch",
    "start:debug": "pnpm db:generate && nest start --debug --watch",
    "start:prod": "pnpm db:generate && node dist/main.js",
    "lint": "oxlint --type-aware src/ test/ prisma/",
    "lint:fix": "oxlint --type-aware --fix src/ test/ prisma/",
    "db:generate": "prisma generate",
    "db:migrate": "prisma generate && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "prepare": "lefthook install || true",
    "secretlint": "secretlint \"**/*\"",
    "spellcheck": "cspell \"**/*\" --no-progress --show-suggestions",
    "test": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "gen-secrets": "node -e \"console.log('JWT_SECRET=' + require('crypto').randomBytes(32).toString('base64')); console.log('JWT_REFRESH_SECRET=' + require('crypto').randomBytes(32).toString('base64'))\"",
    "validate": "pnpm lint && pnpm type-check && pnpm arch:check && pnpm test"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@cspell/dict-en-gb": "5.0.34",
    "@cspell/dict-en_us": "4.4.40",
    "@cspell/dict-ru_ru": "2.3.2",
    "@nestjs/cli": "12.0.0",
    "@nestjs/mau": "0.2.6",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/express": "5.0.0",
    "@types/node": "24.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.2",
    "cspell": "10.3.3",
    "dependency-cruiser": "18.4.0",
    "dotenv": "18.0.2",
    "lefthook": "2.1.14",
    "oxlint": "1.58.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.4.2",
    "prisma": "6.19.3",
    "secretlint": "13.0.5",
    "source-map-support": "0.5.21",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
